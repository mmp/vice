# Image for running wxpackage as a Cloud Run job. Build from the repository
# root (see run.sh):
#   docker buildx build --platform linux/amd64 -f cmd/wxingest/cloudrun/Dockerfile.wxpackage .
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /out/wxpackage ./cmd/wxpackage

FROM gcr.io/distroless/static-debian12
WORKDIR /app
COPY --from=build /out/wxpackage ./wxpackage
# Unlike the wxingest image, this one keeps resources/videomaps: wxpackage
# takes the airports and ARTCCs to package from the scenarios, and loading
# those validates each one's video map against the .mappack files.
COPY resources/ ./resources/
ENTRYPOINT ["/app/wxpackage"]
